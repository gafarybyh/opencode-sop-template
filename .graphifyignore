# Graphify ignore — files and folders excluded from the code graph.
# Same syntax as .gitignore (glob patterns, # comments, blank lines).
# Copied into each project by copy-to-project.ps1 alongside .gitignore.
# Graph only what matters: source code + docs. Everything else stays out
# to keep `graphify update .` fast and the graph relevant.

# --- dependencies ---
node_modules/
.opencode/node_modules/

# --- generated output (regenerated by tooling, not source) ---
graphify-out/
.opencode/graphify-out/
dist/
build/
out/
.next/
.nuxt/
.coverage/
coverage/
.hallmark/
.playwright-cli/
.eval/
eval/

# --- env and secrets ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12

# --- build / cache artefacts ---
*.pyc
__pycache__/
*.pyo
*.class
*.o
*.so
*.dll
*.exe
*.bin

