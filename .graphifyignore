# Graphify ignore — agent creates this file per project from scratch.
# Same syntax as .gitignore. Graph only source code + docs; exclude the SOP
# folder (.opencode/), generated output, and test scratch.

# --- SOP / template internals (never graphed) ---
.opencode/

# --- dependencies ---
node_modules/

# --- generated output ---
graphify-out/
dist/
build/
out/
.next/
.nuxt/
.coverage/
coverage/
.hallmark/
.playwright-cli/
eval/

# --- env and secrets ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12

# --- build / cache artefacts ---
*.pyc
__pycache__/
*.pyo
*.class
*.o
*.so
*.dll
*.exe
*.bin

# --- editor / OS noise ---
.DS_Store
Thumbs.db
*.tmp
*~
.idea/
.vscode/

# --- test scratch (ad-hoc projects, never graphed) ---
_skill-test-*/
_sop-test-*/
SOP Test Coding/
test-subagent/
